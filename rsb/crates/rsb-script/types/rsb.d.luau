--- The new scroll offset in logical px
export type ScrollEvent = { x: number, y: number }

--- An animate prop value: run @keyframes name (made by rsb.animate)
export type Animate = { name: string }

--- restart: the animation starts again from the start whenever this value changes
export type AnimateOptions = { duration: Duration?, easing: string?, delay: Duration?, iterations: number?, direction: string?, fill: string?, restart: any? }

--- Default 1 MiB, max 8 MiB
export type FileOptions = { max_bytes: number? }

--- The file's text, kept current; nil while it is missing
export type FileSignal = { value: string?, error: string? }

--- A monitor as the window manager reports it
export type Monitor = {
    --- 0-based position in the window manager's list
    index: number,
    --- the window manager's name for it
    name: string,
    --- HMONITOR value when the window manager reports it; matches ctx.monitor.handle
    handle: number?,
    --- Windows device name, e.g. \\.\DISPLAY1, when known
    device: string?,
    --- workspaces on this monitor, in order
    workspaces: {Workspace},
}

--- One workspace
export type Workspace = {
    --- unique name; pass it to focus()
    name: string,
    --- label to show
    display_name: string,
    --- has keyboard focus
    focused: boolean,
    --- shown on its monitor
    visible: boolean,
    --- at least one window
    has_windows: boolean,
    --- number of windows
    window_count: number,
}

--- An audio output or input device
export type AudioDevice = {
    --- Windows' endpoint id; pass it to set_default and the other device commands
    id: string,
    --- the name Windows shows (never logged)
    name: string,
    --- "output" or "input"
    kind: AudioDeviceKind,
    --- the default device of its kind
    default: boolean,
    --- 0-100
    volume: number,
    --- muted
    muted: boolean,
    --- a Bluetooth device
    bluetooth: boolean,
}

--- A paired Bluetooth device
export type BluetoothDevice = {
    --- device id; pass it to connect, disconnect and forget
    id: string,
    --- the device's name (never logged)
    name: string,
    --- what sort of device it is
    kind: BluetoothKind,
    --- connected now
    connected: boolean,
    --- battery 0-100 when the device reports it
    battery: number?,
    --- RSB can connect and disconnect it (audio devices)
    can_connect: boolean,
}

--- An app from the Start menu
export type App = {
    --- launch id; pass it to launch
    id: string,
    --- the name the Start menu shows
    name: string,
    --- image key for rsb.image { src = app.icon }, once the icon is ready
    icon: string?,
}

--- A Wi-Fi network in range
export type WifiNetwork = {
    --- network name; nil when Windows withholds it (location permission) (never logged)
    ssid: string?,
    --- signal 0-100
    signal: number,
    --- needs a password
    secure: boolean,
    --- connected now
    connected: boolean,
    --- Windows has a saved profile for it
    known: boolean,
}

--- CPU and memory load, sampled while someone reads it (default every 2 s)
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type SystemService = {
    --- CPU load in percent, 0-100, over the last interval
    cpu: number?,
    --- memory in use in percent, 0-100
    memory: number?,
    --- memory in use, bytes
    memory_used: number?,
    --- installed memory visible to Windows, bytes
    memory_total: number?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- sample every d (the fastest reader wins; calling again replaces your wish)
    interval: (self: SystemService, d: Duration) -> (),
}

--- Battery and power source
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type BatteryService = {
    --- false on a PC without a battery: show nothing or a plug
    present: boolean?,
    --- charge 0-100 when present
    percent: number?,
    --- charging now
    charging: boolean?,
    --- on mains power
    plugged: boolean?,
    --- battery saver is on
    saver: boolean?,
    --- estimated seconds of battery left, when Windows knows
    seconds_left: number?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
}

--- Default output device volume
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type AudioService = {
    --- an output device exists
    available: boolean?,
    --- 0-100
    volume: number?,
    --- muted
    muted: boolean?,
    --- output devices, the default first
    devices: {AudioDevice}?,
    --- input (recording) devices, the default first
    inputs: {AudioDevice}?,
    --- set_default works here (it uses an interface Windows does not document)
    switch_available: boolean?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- set the volume, 0-100
    set_volume: (self: AudioService, percent: number) -> (),
    --- add delta (may be negative) to the volume
    change_volume: (self: AudioService, delta: number) -> (),
    --- mute or unmute
    set_muted: (self: AudioService, muted: boolean) -> (),
    --- flip mute
    toggle_mute: (self: AudioService) -> (),
    --- make this output the default
    set_default: (self: AudioService, id: string) -> (),
    --- set one device's volume, 0-100
    set_device_volume: (self: AudioService, id: string, percent: number) -> (),
    --- mute or unmute one device
    set_device_muted: (self: AudioService, id: string, muted: boolean) -> (),
}

--- Connection state and throughput (rates sampled while read, default every 2 s)
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type NetworkService = {
    --- any network connected
    connected: boolean?,
    --- Windows reports internet access
    internet: boolean?,
    --- "wifi", "ethernet", "cellular", "other" or "none"
    kind: NetworkKind?,
    --- Wi-Fi network name (never logged)
    ssid: string?,
    --- Wi-Fi signal 0-100
    signal: number?,
    --- bytes per second received, all adapters
    down_bps: number?,
    --- bytes per second sent, all adapters
    up_bps: number?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- sample every d (the fastest reader wins; calling again replaces your wish)
    interval: (self: NetworkService, d: Duration) -> (),
}

--- The current media session (Windows media controls)
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type MediaService = {
    --- a media session exists
    available: boolean?,
    --- playing now
    playing: boolean?,
    --- track title, empty when unknown (never logged)
    title: string?,
    --- artist, empty when unknown (never logged)
    artist: string?,
    --- album, empty when unknown
    album: string?,
    --- app id of the player
    source: string?,
    --- play/pause is allowed
    can_play_pause: boolean?,
    --- next is allowed
    can_next: boolean?,
    --- previous is allowed
    can_previous: boolean?,
    --- seconds into the track when position_at was read
    position: number?,
    --- when position was read, ms since 1970 (add the time since while playing)
    position_at: number?,
    --- track length in seconds
    length: number?,
    --- seek is allowed
    can_seek: boolean?,
    --- image key of the cover for rsb.image { src = media.art } (kept in memory only)
    art: string?,
    --- image key of the player app's own icon, when Windows has one for it
    app_icon: string?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- toggle play and pause
    play_pause: (self: MediaService) -> (),
    --- play
    play: (self: MediaService) -> (),
    --- pause
    pause: (self: MediaService) -> (),
    --- next track
    next: (self: MediaService) -> (),
    --- previous track
    previous: (self: MediaService) -> (),
    --- jump to this position in the track
    seek: (self: MediaService, seconds: number) -> (),
}

--- The foreground window
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type WindowService = {
    --- a normal window has focus (false on the desktop)
    has_window: boolean?,
    --- window title (never logged)
    title: string?,
    --- program file name without folder, e.g. "Code.exe"
    process: string?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
}

--- Workspaces from a running window manager (GlazeWM-compatible WebSocket, e.g. Astur or GlazeWM, or komorebi)
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type WorkspacesService = {
    --- "glazewm", "komorebi" or "none"
    provider: WorkspaceProvider?,
    --- talking to a window manager now
    connected: boolean?,
    --- monitors with their workspaces; empty when none
    monitors: {Monitor}?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- switch to the workspace with this name
    focus: (self: WorkspacesService, name: string) -> (),
    --- next workspace on a monitor (default: the focused one)
    focus_next: (self: WorkspacesService, monitor: number?) -> (),
    --- previous workspace on a monitor
    focus_previous: (self: WorkspacesService, monitor: number?) -> (),
}

--- The default recording device, and whether any app is using a microphone
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type MicrophoneService = {
    --- a recording device exists
    available: boolean?,
    --- the default recording device is muted
    muted: boolean?,
    --- its level, 0-100
    volume: number?,
    --- an app is recording from a microphone now
    in_use: boolean?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- mute or unmute the default recording device
    set_muted: (self: MicrophoneService, muted: boolean) -> (),
    --- flip its mute
    toggle_mute: (self: MicrophoneService) -> (),
}

--- The Bluetooth radio and paired devices
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type BluetoothService = {
    --- this PC has a Bluetooth radio
    available: boolean?,
    --- the radio is on
    enabled: boolean?,
    --- RSB may turn the radio on and off
    can_toggle: boolean?,
    --- paired devices, connected first
    devices: {BluetoothDevice}?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- turn the radio on or off
    set_enabled: (self: BluetoothService, on: boolean) -> (),
    --- connect a paired audio device
    connect: (self: BluetoothService, id: string) -> (),
    --- disconnect a paired audio device
    disconnect: (self: BluetoothService, id: string) -> (),
    --- remove a pairing
    forget: (self: BluetoothService, id: string) -> (),
    --- open Windows' Bluetooth page to pair a new device
    open_settings: (self: BluetoothService) -> (),
    --- read the paired devices and their state again
    rescan: (self: BluetoothService) -> (),
}

--- Apps in the Start menu, for a launcher
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type AppsService = {
    --- the list has been read
    ready: boolean?,
    --- every app, sorted by name
    apps: {App}?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- start an app
    launch: (self: AppsService, id: string) -> (),
    --- open a Windows page: ms-settings: or ms-screenclip: only
    open_uri: (self: AppsService, uri: string) -> (),
}

--- Power mode and the lock, sleep, restart, shut down and sign out actions
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type PowerService = {
    --- "efficiency", "balanced", "performance" or "unknown"
    mode: PowerMode?,
    --- set_mode works here (it uses an interface Windows does not document)
    mode_available: boolean?,
    --- this PC can sleep
    can_sleep: boolean?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- change the power mode
    set_mode: (self: PowerService, mode: PowerMode) -> (),
    --- lock the PC (Windows' lock screen)
    lock: (self: PowerService) -> (),
    --- sleep
    sleep: (self: PowerService) -> (),
    --- restart
    restart: (self: PowerService) -> (),
    --- shut down
    shut_down: (self: PowerService) -> (),
    --- sign out
    sign_out: (self: PowerService) -> (),
}

--- Wi-Fi networks in range
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type WifiService = {
    --- this PC has a Wi-Fi adapter
    available: boolean?,
    --- a scan is running
    scanning: boolean?,
    --- networks in range, strongest first
    networks: {WifiNetwork}?,
    --- "needs_location": Windows shares network lists with desktop apps only when location is on for them
    access: WifiAccess?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- look for networks again
    scan: (self: WifiService) -> (),
    --- connect to a network Windows has a saved profile for
    connect: (self: WifiService, ssid: string) -> (),
    --- disconnect from the current network
    disconnect: (self: WifiService) -> (),
}

export type Rsb = {
    --- API version, 1.
    version: number,
    --- Defines a widget; a widget file returns this.
    widget: <O>(spec: WidgetSpec<O>) -> Widget,
    --- A flex container, children in a row.
    box: (props: BoxProps) -> Element,
    --- A box laid out left to right.
    row: (props: BoxProps) -> Element,
    --- A box laid out top to bottom.
    column: (props: BoxProps) -> Element,
    --- One line of text (what comes before the first line break).
    text: (props: TextProps | string | number) -> Element,
    --- An icon by name, or a raw glyph.
    icon: (props: IconProps | IconName) -> Element,
    --- A PNG image (needs file permission outside the widget folder).
    image: (props: ImageProps) -> Element,
    --- Children from a list; with key, unchanged items keep their state.
    each: <T>(list: Reactive<{ T }>, render: (item: T, index: number) -> Element, key: ((item: T) -> string)?) -> () -> { Element },
    --- A popup anchored to the element it is a child of; its content is built only while it is open.
    popup: (props: PopupProps) -> Element,
    --- A menu (as a child: anchored; the menu prop of any element opens one at a right click).
    menu: (props: MenuProps) -> Element,
    --- One line of editable text.
    input: (props: InputProps) -> Element,
    --- A value on a track.
    slider: (props: SliderProps) -> Element,
    --- A column that scrolls.
    scroll: (props: BoxProps) -> Element,
    popups: {
        --- Opens the named popup on this widget's monitor (from a user widget only inside a click or key handler, unless it is the widget's own popup).
        open: (name: string) -> (),
        --- Closes the named popup on this widget's monitor.
        close: (name: string) -> (),
        --- Opens the named popup, or closes it when it is open.
        toggle: (name: string) -> (),
        --- Whether the named popup is open on this widget's monitor; read inside a function prop it updates.
        is_open: (name: string) -> boolean,
    },
    --- An animate prop value: runs @keyframes name, again from the start when options.restart changes.
    animate: (name: string, options: AnimateOptions?) -> Animate,
    --- The items that match query, best first, typo tolerant.
    fuzzy: <T>(query: string, items: { T }, options: { key: ((T) -> string)?, limit: number? }?) -> { T },
    --- The 1-based character positions of text that matched query, for highlighting; nil when it does not match.
    fuzzy_match: (query: string, text: string) -> { number }?,
    --- A value you can set; readers update when it changes.
    state: <T>(initial: T) -> State<T>,
    --- A value derived from others; recomputed when they change.
    computed: <T>(fn: () -> T) -> Signal<T>,
    --- Runs fn now and again whenever what it reads changes; fn may return a cleanup.
    effect: (fn: () -> (() -> ())?) -> (),
    --- Several changes, one update.
    batch: (fn: () -> ()) -> (),
    --- Reads without subscribing.
    untrack: <T>(fn: () -> T) -> T,
    --- Runs fn now and every period inside a task (it may wait on I/O); .value holds the last result (nil before the first), .error the last error (the value is kept).
    poll: <T>(every: Duration, fn: () -> T) -> PollSignal<T>,
    --- Runs fn when the widget unloads or reloads.
    on_cleanup: (fn: () -> ()) -> (),
    task: {
        --- Starts a task: code that may wait on I/O without blocking anything.
        spawn: (fn: () -> ()) -> Task,
        --- Waits inside a task. Waits for a result: call it inside a task.
        sleep: (d: Duration) -> (),
        --- Stops a task (same as task:cancel()).
        cancel: (task: Task) -> (),
    },
    timer: {
        --- Calls fn every d; whole seconds, minutes and hours line up with the clock.
        every: (d: Duration, fn: () -> ()) -> Timer,
        --- Calls fn once after d.
        after: (d: Duration, fn: () -> ()) -> Timer,
    },
    --- The time, updated on each whole second / minute / hour and at once after sleep or a clock change; timezone "local" (default), "utc" or "+10:00".
    clock: (precision: ("second" | "minute" | "hour")?, timezone: string?) -> Signal<Time>,
    time: {
        --- The time now.
        now: (timezone: string?) -> Time,
        --- Formats a time: yyyy MM MMM dd ddd HH hh mm ss tt (see the docs).
        format: (t: Time, format: string) -> string,
        --- The finest unit a format shows.
        precision: (format: string) -> "second" | "minute" | "hour",
    },
    services: {
        --- CPU and memory.
        system: SystemService,
        --- Battery.
        battery: BatteryService,
        --- Volume.
        audio: AudioService,
        --- Network.
        network: NetworkService,
        --- Media session.
        media: MediaService,
        --- Foreground window.
        window: WindowService,
        --- Window manager workspaces.
        workspaces: WorkspacesService,
        --- Default recording device.
        microphone: MicrophoneService,
        --- Bluetooth radio and paired devices.
        bluetooth: BluetoothService,
        --- Start menu apps.
        apps: AppsService,
        --- Power mode, lock and the session actions.
        power: PowerService,
        --- Wi-Fi networks in range.
        wifi: WifiService,
    },
    exec: {
        --- Runs a program (argument list, no shell) and waits for it. Waits for a result: call it inside a task.
        run: (command: { string }, options: ExecOptions?) -> ExecResult,
        --- Runs a command line through cmd.exe (needs exec permission for "cmd"). Waits for a result: call it inside a task.
        shell: (command: string, options: ExecOptions?) -> ExecResult,
        --- Starts a long-running program and streams its lines.
        spawn: (command: { string }, options: SpawnOptions?) -> Process,
        --- The latest line a long-running program printed.
        lines: (command: { string }) -> Signal<string?>,
    },
    file: {
        --- Reads a text file; returns text, or nil and the reason. Waits for a result: call it inside a task.
        read: (path: string, options: FileOptions?) -> (string?, string?),
        --- A file's text, re-read whenever it changes.
        watch: (path: string, options: FileOptions?) -> FileSignal,
    },
    http: {
        --- HTTPS GET. Waits for a result: call it inside a task.
        get: (url: string, options: HttpOptions?) -> Response,
        --- HTTPS POST; a table body is sent as JSON. Waits for a result: call it inside a task.
        post: (url: string, body: string | { [any]: any }, options: HttpOptions?) -> Response,
    },
    json: {
        --- JSON text (at most 2 MiB, 64 levels deep) to a value; null becomes nil.
        decode: (text: string) -> any,
        --- A value to JSON text (tables that contain themselves or nest over 64 levels are refused).
        encode: (value: any) -> string,
    },
    --- Opens an https URL in the default browser: only inside a click or key handler, at most one address every 2 seconds (needs net permission for its host).
    open_url: (url: string) -> (),
    events: {
        --- Runs fn (as a task, on the next turn) for `rsb trigger <name> [json]` and rsb.events.emit; data comes from outside the widget, check it.
        on: (name: string, fn: (data: any) -> ()) -> Subscription,
        --- Sends an event to every widget (at most 50 a second and 1 MiB of data a second per widget; one event carries at most 64 KiB).
        emit: (name: string, data: any?) -> (),
    },
    theme: {
        --- Windows' app theme is dark (reactive).
        dark: boolean,
    },
    log: {
        --- Writes to the RSB log (print does the same); 20 lines a second, line breaks escaped. What you log is yours: keep titles and names out.
        info: (...any) -> (),
        --- Writes a warning to the log.
        warn: (...any) -> (),
        --- Writes an error to the log.
        error: (...any) -> (),
    },
    format: {
        --- 1536 -> "1.5 KB" (1024-based).
        bytes: (n: number) -> string,
        --- Bytes per second -> "1.2 MB/s".
        rate: (bytes_per_sec: number) -> string,
        --- 23.4 -> "23%".
        percent: (n: number) -> string,
    },
}

return (nil :: any) :: Rsb
