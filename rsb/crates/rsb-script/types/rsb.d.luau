--- Connection state and throughput (rates sampled while read, default every 2 s)
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type NetworkService = {
    --- any network connected
    connected: boolean?,
    --- Windows reports internet access
    internet: boolean?,
    --- "wifi", "ethernet", "cellular", "other" or "none"
    kind: NetworkKind?,
    --- Wi-Fi network name (never logged)
    ssid: string?,
    --- Wi-Fi signal 0-100
    signal: number?,
    --- bytes per second received, all adapters
    down_bps: number?,
    --- bytes per second sent, all adapters
    up_bps: number?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- sample every d (the fastest reader wins; calling again replaces your wish)
    interval: (self: NetworkService, d: Duration) -> (),
}

--- The current media session (Windows media controls)
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type MediaService = {
    --- a media session exists
    available: boolean?,
    --- playing now
    playing: boolean?,
    --- track title, empty when unknown (never logged)
    title: string?,
    --- artist, empty when unknown (never logged)
    artist: string?,
    --- album, empty when unknown
    album: string?,
    --- app id of the player
    source: string?,
    --- play/pause is allowed
    can_play_pause: boolean?,
    --- next is allowed
    can_next: boolean?,
    --- previous is allowed
    can_previous: boolean?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- toggle play and pause
    play_pause: (self: MediaService) -> (),
    --- play
    play: (self: MediaService) -> (),
    --- pause
    pause: (self: MediaService) -> (),
    --- next track
    next: (self: MediaService) -> (),
    --- previous track
    previous: (self: MediaService) -> (),
}

--- The foreground window
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type WindowService = {
    --- a normal window has focus (false on the desktop)
    has_window: boolean?,
    --- window title (never logged)
    title: string?,
    --- program file name without folder, e.g. "Code.exe"
    process: string?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
}

--- Workspaces from a running window manager (GlazeWM-compatible WebSocket, e.g. Astur or GlazeWM, or komorebi)
--- The values are nil until the first reading arrives (status "starting"): check before using one.
export type WorkspacesService = {
    --- "glazewm", "komorebi" or "none"
    provider: WorkspaceProvider?,
    --- talking to a window manager now
    connected: boolean?,
    --- monitors with their workspaces; empty when none
    monitors: {Monitor}?,
    --- "off", "starting", "ok", "stale", "unavailable" or "error"
    status: ServiceStatus,
    --- true when status is "stale": show a placeholder, not the old value
    stale: boolean,
    --- why the service is unavailable or failing
    error: string?,
    --- switch to the workspace with this name
    focus: (self: WorkspacesService, name: string) -> (),
    --- next workspace on a monitor (default: the focused one)
    focus_next: (self: WorkspacesService, monitor: number?) -> (),
    --- previous workspace on a monitor
    focus_previous: (self: WorkspacesService, monitor: number?) -> (),
}

export type Rsb = {
    --- API version, 1.
    version: number,
    --- Defines a widget; a widget file returns this.
    widget: <O>(spec: WidgetSpec<O>) -> Widget,
    --- A flex container, children in a row.
    box: (props: BoxProps) -> Element,
    --- A box laid out left to right.
    row: (props: BoxProps) -> Element,
    --- A box laid out top to bottom.
    column: (props: BoxProps) -> Element,
    --- One line of text (what comes before the first line break).
    text: (props: TextProps | string | number) -> Element,
    --- An icon by name, or a raw glyph.
    icon: (props: IconProps | IconName) -> Element,
    --- A PNG image (needs file permission outside the widget folder).
    image: (props: ImageProps) -> Element,
    --- Children from a list; with key, unchanged items keep their state.
    each: <T>(list: Reactive<{ T }>, render: (item: T, index: number) -> Element, key: ((item: T) -> string)?) -> () -> { Element },
    --- A value you can set; readers update when it changes.
    state: <T>(initial: T) -> State<T>,
    --- A value derived from others; recomputed when they change.
    computed: <T>(fn: () -> T) -> Signal<T>,
    --- Runs fn now and again whenever what it reads changes; fn may return a cleanup.
    effect: (fn: () -> (() -> ())?) -> (),
    --- Several changes, one update.
    batch: (fn: () -> ()) -> (),
    --- Reads without subscribing.
    untrack: <T>(fn: () -> T) -> T,
    --- Runs fn now and every period inside a task (it may wait on I/O); .value holds the last result (nil before the first), .error the last error (the value is kept).
    poll: <T>(every: Duration, fn: () -> T) -> PollSignal<T>,
    --- Runs fn when the widget unloads or reloads.
    on_cleanup: (fn: () -> ()) -> (),
    task: {
        --- Starts a task: code that may wait on I/O without blocking anything.
        spawn: (fn: () -> ()) -> Task,
        --- Waits inside a task. Waits for a result: call it inside a task.
        sleep: (d: Duration) -> (),
        --- Stops a task (same as task:cancel()).
        cancel: (task: Task) -> (),
    },
    timer: {
        --- Calls fn every d; whole seconds, minutes and hours line up with the clock.
        every: (d: Duration, fn: () -> ()) -> Timer,
        --- Calls fn once after d.
        after: (d: Duration, fn: () -> ()) -> Timer,
    },
    --- The time, updated on each whole second / minute / hour and at once after sleep or a clock change; timezone "local" (default), "utc" or "+10:00".
    clock: (precision: ("second" | "minute" | "hour")?, timezone: string?) -> Signal<Time>,
    time: {
        --- The time now.
        now: (timezone: string?) -> Time,
        --- Formats a time: yyyy MM MMM dd ddd HH hh mm ss tt (see the docs).
        format: (t: Time, format: string) -> string,
        --- The finest unit a format shows.
        precision: (format: string) -> "second" | "minute" | "hour",
    },
    services: {
        --- CPU and memory.
        system: SystemService,
        --- Battery.
        battery: BatteryService,
        --- Volume.
        audio: AudioService,
        --- Network.
        network: NetworkService,
        --- Media session.
        media: MediaService,
        --- Foreground window.
        window: WindowService,
        --- Window manager workspaces.
        workspaces: WorkspacesService,
    },
    exec: {
        --- Runs a program (argument list, no shell) and waits for it. Waits for a result: call it inside a task.
        run: (command: { string }, options: ExecOptions?) -> ExecResult,
        --- Runs a command line through cmd.exe (needs exec permission for "cmd"). Waits for a result: call it inside a task.
        shell: (command: string, options: ExecOptions?) -> ExecResult,
        --- Starts a long-running program and streams its lines.
        spawn: (command: { string }, options: SpawnOptions?) -> Process,
        --- The latest line a long-running program printed.
        lines: (command: { string }) -> Signal<string?>,
    },
    file: {
        --- Reads a text file; returns text, or nil and the reason. Waits for a result: call it inside a task.
        read: (path: string, options: FileOptions?) -> (string?, string?),
        --- A file's text, re-read whenever it changes.
        watch: (path: string, options: FileOptions?) -> FileSignal,
    },
    http: {
        --- HTTPS GET. Waits for a result: call it inside a task.
        get: (url: string, options: HttpOptions?) -> Response,
        --- HTTPS POST; a table body is sent as JSON. Waits for a result: call it inside a task.
        post: (url: string, body: string | { [any]: any }, options: HttpOptions?) -> Response,
    },
    json: {
        --- JSON text (at most 2 MiB, 64 levels deep) to a value; null becomes nil.
        decode: (text: string) -> any,
        --- A value to JSON text (tables that contain themselves or nest over 64 levels are refused).
        encode: (value: any) -> string,
    },
    --- Opens an https URL in the default browser: only while a click is being handled, at most one address every 2 seconds (needs net permission for its host).
    open_url: (url: string) -> (),
    events: {
        --- Runs fn (as a task, on the next turn) for `rsb trigger <name> [json]` and rsb.events.emit; data comes from outside the widget, check it.
        on: (name: string, fn: (data: any) -> ()) -> Subscription,
        --- Sends an event to every widget (at most 50 a second and 1 MiB of data a second per widget; one event carries at most 64 KiB).
        emit: (name: string, data: any?) -> (),
    },
    theme: {
        --- Windows' app theme is dark (reactive).
        dark: boolean,
    },
    log: {
        --- Writes to the RSB log (print does the same); 20 lines a second, line breaks escaped. What you log is yours: keep titles and names out.
        info: (...any) -> (),
        --- Writes a warning to the log.
        warn: (...any) -> (),
        --- Writes an error to the log.
        error: (...any) -> (),
    },
    format: {
        --- 1536 -> "1.5 KB" (1024-based).
        bytes: (n: number) -> string,
        --- Bytes per second -> "1.2 MB/s".
        rate: (bytes_per_sec: number) -> string,
        --- 23.4 -> "23%".
        percent: (n: number) -> string,
    },
}

return (nil :: any) :: Rsb
